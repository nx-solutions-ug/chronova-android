<?xml version="1.0" encoding="utf-8"?>
<resources xmlns:tools="http://schemas.android.com/tools">

    <!--
        Readable TextInputLayout defaults for the dark Chronova theme.

        The mixed Material2/Material3 theme that ships with the app renders the
        OutlinedBox hint and box stroke using colorPrimary (a dark blue-grey) on
        the dark background, which leaves the input text and labels unreadable.
        This style pins the text, hint and stroke colors to the readable palette
        in res/values/colors.xml so every input in the app stays legible.
    -->
    <style name="Chronova.TextInputLayout" parent="Widget.MaterialComponents.TextInputLayout.OutlinedBox">
        <item name="boxStrokeColor">@color/text_primary</item>
        <item name="boxStrokeErrorColor">@color/error</item>
        <item name="hintTextColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
        <item name="passwordToggleTint">@color/text_secondary</item>
    </style>

    <style name="Chronova.TextInputEditText" parent="Widget.MaterialComponents.TextInputEditText.OutlinedBox">
        <item name="android:textColor">@color/text_primary</item>
        <item name="android:textColorHint">@color/text_secondary</item>
    </style>

</resources>
